{
	"name": "props-bot-action",
	"version": "1.0.0",
	"description": "Generates WordPress.org style props for easy pasting into merge commit messages.",
	"author": "The WordPress Contributors",
	"license": "MIT",
	"keywords": [
		"WordPress",
		"GitHub",
		"Actions",
		"JavaScript"
	],
	"homepage": "https://github.com/WordPress/props-bot#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/props-bot.git"
	},
	"bugs": {
		"url": "https://github.com/WordPress/props-bot/issues"
	},
	"engines": {
		"node": ">=24.15.0",
		"npm": ">=11.6.1"
	},
	"main": "index.js",
	"npmpackagejsonlint": {
		"extends": "@wordpress/npm-package-json-lint-config",
		"rules": {
			"valid-values-license": [
				"error",
				[
					"MIT"
				]
			]
		}
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1"
	},
	"devDependencies": {
		"@vercel/ncc": "^0.45.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/npm-package-json-lint-config": "^5.57.0",
		"@wordpress/scripts": "^37.0.0",
		"eslint": "^10.13.0",
		"npm-run-all": "^4.1.5",
		"prettier": "npm:wp-prettier@^3.9.6"
	},
	"scripts": {
		"lint": "npm-run-all lint:js lint:pkg-json",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"prepare": "ncc build index.js -o dist --license licenses.txt",
		"test": "node --test \"tests/**/*.test.mjs\"",
		"all": "npm-run-all lint prepare test"
	}
}
